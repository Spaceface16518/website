rer{border-right:1px solid var(--line);padding:22px 0;display:flex;flex-direction:column}.explorer-heading{font:10px monospace;color:var(--muted);padding:0 22px;display:flex;justify-content:space-between;margin-bottom:20px}.project-choice{display:flex;align-items:center;font-size:13px;gap:12px;padding:15px 20px;color:#c3ccbb;border-left:2px solid transparent}.project-choice:hover{background:#272f21}.project-choice.is-active{background:#2c3624;border-left-color:var(--accent);color:var(--accent)}.choice-symbol{font-size:16px;width:18px}.choice-arrow{margin-left:auto;opacity:0}.is-active .choice-arrow{opacity:1}.explorer-note{font:10px/1.8 monospace;color:#8d9a85;margin:auto 20px 0;padding-top:40px}.panel-file{height:45px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;font:10px monospace;color:var(--muted)}.panel-content{padding:34px 42px 25px}.project-kicker{display:flex;flex-wrap:wrap;gap:15px;align-items:center;justify-content:space-between;color:var(--accent);font:11px monospace;margin-bottom:28px}.stage{border:1px solid #505b45;border-radius:30px;padding:5px 9px;color:#bac6ae;font-size:9px}.project-panel h3{font-size:48px;letter-spacing:-2px;font-weight:500;margin-bottom:8px}.project-panel h3>span{color:var(--accent)}.project-motto{font-size:18px;color:#d4ddcd;margin-bottom:25px}.project-description{font-size:16px;line-height:1.7;max-width:560px;margin-bottom:12px}.project-detail{font-size:14px;line-height:1.7;max-width:560px;color:var(--muted)}.tags{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0 30px}.tags span{font:10px monospace;border:1px solid #3f4937;padding:7px 9px;color:#b3c4a4}.project-footer{display:flex;justify-content:space-between;gap:15px;border-top:1px solid var(--line);padding-top:20px;align-items:center}.footer-label{font:9px monospace;color:#89957f}.project-footer a{font-size:13px;color:var(--accent)}.bench-status{border-top:1px solid var(--line);display:flex;justify-content:spa