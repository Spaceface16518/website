---
import Base from '../layouts/Base.astro';
import { profile, projects, history } from '../data/profile';
const groups = ['All', 'Hardware', 'AI', 'Research'];
---
<Base title="Amrit Rathie — Software engineer" description={profile.intro}>
<div class="lab">
  <header>
    <a class="logo" href="/" aria-label="Amrit Rathie home">AR<span aria-hidden="true">↗</span></a>
    <nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
  </header>
  <main id="main">
    <section class="intro">
      <div><p class="label">SOFTWARE / HARDWARE / RESEARCH</p><h1>Amrit Rathie</h1><p class="bio">{profile.intro}</p><a class="text-link" href="#projects">Selected projects ↓</a></div>
      <aside class="current" aria-label="Current roles"><p class="label">CURRENT WORK</p><p><strong>Fidelity Investments</strong><span>Full-Stack Software Engineer</span></p><p><strong>POWERPERCEPT</strong><span>Founder & CTO</span></p></aside>
    </section>
    <section id="projects">
      <div class="section-top"><h2>Selected projects</h2><p>Products, hackathon projects, and research.</p></div>
      <div class="filters" role="group" aria-label="Filter projects by discipline" hidden>{groups.map((g,i)=><button type="button" data-filter={g} aria-pressed={i===0}>{g}</button>)}<span id="result-count" aria-live="polite">{projects.length} projects</span></div>
      <div class="project-grid">{projects.map(p=><article data-group={p.category}>
        <p class="project-stage">{p.stage}</p><h3>{p.name}</h3><p>{p.description}</p>
        <details><summary>Details <span aria-hidden="true">+</span></summary><p>{p.detail}</p>{p.href && <a href={p.href}>View source ↗</a>}</details>
        <div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div>
      </article>)}</div>
    </section>
    <section id="about" class="profile">
      <div><h2>About</h2><p>{profile.about}</p><p>{profile.community}</p><a class="text-link" href={profile.linkedin}>LinkedIn ↗</a></div>
      <aside><h2>Education & experience</h2><ol>{history.map(h=><li><span class="date">{h.date}</span><h3>{h.title}</h3><p>{h.text}</p></li>)}</ol></aside>
    </section>
    <section id="contact" class="contact"><h2>Contact</h2><a href={`mailto:${profile.email}`}>{profile.email} ↗</a></section>
  </main>
  <footer><span>© {new Date().getFullYear()} Amrit Rathie</span><div><a href={profile.github}>GitHub</a><a href={profile.linkedin}>LinkedIn</a><a href="#main">Back to top ↑</a></div></footer>
</div>
</Base>
<script>
const filters = document.querySelector<HTMLElement>('.filters');
if (filters) filters.hidden = false;
const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
  document.querySelectorAll('[data-filter]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
  let count = 0;
  cards.forEach(card => { card.hidden = button.dataset.filter !== 'All' && card.dataset.group !== button.dataset.filter; if (!card.hidden) count++; });
  const result = document.getElementById('result-count');
  if (result) result.textContent = `${count} ${count === 1 ? 'project' : 'projects'}`;
}));
</script>
<style is:global>
:root{--ink:#18355f;--blue:#2857b8;--paper:#fafbf8;--line:#d6dee7;--muted:#52647c}
body{background:var(--paper);color:var(--ink);font:16px/1.65 Arial,Helvetica,sans-serif}
.lab{max-width:1200px;padding:0 5%;margin:auto}
header{display:flex;align-items:center;justify-content:space-between;padding:25px 0;border-bottom:1px solid var(--line)}
.logo{display:flex;align-items:center;gap:8px;text-decoration:none;font-size:24px;font-weight:700;letter-spacing:-1px}.logo span{display:grid;place-items:center;width:23px;height:23px;background:var(--blue);color:white;font-size:20px;font-weight:400}
nav{display:flex;gap:28px;font-size:13px}nav a,footer a{text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:4px}
.intro{display:grid;grid-template-columns:1.6fr 1fr;gap:70px;padding:72px 0 65px;align-items:center}
.label{font:10px monospace;letter-spacing:1.3px;color:var(--muted)}
h1{font-size:clamp(42px,5.5vw,68px);font-weight:500;letter-spacing:-2.5px;line-height:1.1;margin:22px 0}.bio{max-width:570px;font-size:18px;line-height:1.7;color:var(--muted)}
.text-link{font-size:13px;text-underline-offset:5px}.current{border-left:1px solid var(--line);padding-left:30px}.current p{margin-bottom:22px}.current p:last-child{margin:0}.current strong{display:block;font-size:15px;font-weight:500}.current span{font-size:12px;color:var(--muted)}
#projects{border-top:1px solid var(--line);padding:42px 0 60px}.section-top{display:flex;align-items:baseline;justify-content:space-between;gap:20px}.section-top p{font-size:13px;color:var(--muted)}h2{font-size:28px;letter-spacing:-.7px;line-height:1.25;font-weight:500;margin:0 0 24px}
.filters{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:4px 0 24px}.filters[hidden]{display:none}.filters button{border:1px solid var(--line);background:transparent;color:var(--ink);padding:8px 14px;font-size:12px}.filters button[aria-pressed=true]{background:var(--ink);color:white;border-color:var(--ink)}#result-count{font:11px monospace;color:var(--muted);margin-left:auto}
.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.project-grid article{padding:26px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column}.project-grid article[hidden]{display:none}
.project-stage{font:11px/1.6 monospace;color:var(--muted);margin-bottom:15px}h3{font-size:21px;font-weight:500;letter-spacing:-.4px;line-height:1.3;margin:0 0 12px}.project-grid article>p:not(.project-stage){font-size:14px;color:var(--muted)}details{font-size:13px;margin-bottom:14px}summary{display:flex;justify-content:space-between;cursor:pointer;list-style:none;padding:6px 0}summary::-webkit-details-marker{display:none}details[open] summary span{transform:rotate(45deg)}details p{margin:12px 0;color:var(--muted)}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:10px}.tags span{font:10px monospace;color:var(--muted);border:1px solid var(--line);padding:4px 6px}
.profile{display:grid;grid-template-columns:1fr 1fr;gap:65px;border-top:1px solid var(--line);padding:48px 0}.profile>div>p{font-size:15px;color:var(--muted)}.profile ol{list-style:none;margin:0;padding:0}.profile li{border-left:1px solid var(--line);padding:0 0 26px 20px}.profile li:last-child{padding-bottom:0}.date{font:11px monospace;color:var(--muted)}.profile h3{font-size:16px;margin:9px 0}.profile li p{font-size:13px;color:var(--muted);margin:0}
.contact{border-top:1px solid var(--line);padding:35px 0 50px}.contact a{font-size:18px;text-underline-offset:6px}footer{border-top:1px solid var(--line);padding:24px 0;display:flex;justify-content:space-between;gap:20px;font-size:11px;color:var(--muted)}footer div{display:flex;gap:20px}
@media(max-width:700px){.lab{padding:0 6%}.intro{grid-template-columns:1fr;gap:24px;padding:42px 0}.bio{font-size:16px}.current{display:none}.project-grid{grid-template-columns:1fr}.section-top{display:block}.section-top h2{margin-bottom:10px}.section-top p{margin-bottom:22px}.profile{grid-template-columns:1fr;gap:36px}h1{font-size:48px}.project-grid article{padding:22px}nav{gap:20px}footer{flex-wrap:wrap}.contact a{font-size:16px}}
@media(max-width:360px){h1{font-size:41px}.filters button{padding:7px 10px}#result-count{font-size:10px}}
</style>
