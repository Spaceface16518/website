---
import Base from '../layouts/Base.astro';
import { profile, projects, history } from '../data/profile';
const notes: Record<string, string> = { powerpercept: 'Physical signals, useful data.', headershim: 'Small tool. Better workflow.', dsupload: 'Careful software for personal media.', creative: 'Creative work, reproducible systems.', planner: 'Built together, for students.', swarm: 'Simple rules. Collective behavior.' };
---
<Base title="Amrit Rathie — The workspace">
<div class="site-shell">
<header class="topbar"><a class="wordmark" href="#">ar<span>_</span></a><span class="path">amrit / <strong>workspace</strong></span><nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#about">About</a><a href="/resume.pdf" target="_blank">Résumé ↗</a></nav><a class="contact-top" href={`mailto:${profile.email}`}>Get in touch <span>↗</span></a></header>
<main id="main">
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> THE PERSONAL WORKSPACE OF AMRIT RATHIE</p><h1>Curiosity in.<br/>Useful things <em>out.</em></h1><p class="hero-intro">{profile.intro}</p><div class="hero-links"><a class="primary" href="#projects">Explore my work <span>↓</span></a><a class="quiet" href={profile.github}>GitHub ↗</a></div><div class="hero-meta"><span>Based in Grapevine, TX</span><span>Software + systems + a little solder</span></div></div><div class="hero-art" aria-hidden="true"><div class="art-top"><span>INTERESTS.GRAPH</span><span>01 — ∞</span></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="center-node">ar<span>_</span></div><span class="node node-a">SOFTWARE</span><span class="node node-b">HARDWARE</span><span class="node node-c">PEOPLE</span><div class="art-bottom"><span>INPUT: A GOOD QUESTION</span><span>↗</span></div></div></section>
<section id="projects" class="projects-section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>A few open tabs.</h2></div><p>Different domains. The same instinct<br/>to understand, experiment, and build.</p></div><div class="workbench"><div class="bench-bar"><div class="dots"><i></i><i></i><i></i></div><span>projects / explorer</span><span class="file-count">{projects.length} PROJECTS</span></div><div class="bench-body"><aside class="explorer"><p class="explorer-heading">EXPLORER <span>−</span></p><div class="project-nav" aria-label="Project selection">{projects.map((project,i)=><a class:list={['project-choice',{'is-active':i===0}]} href={`#project-${project.id}`} data-project={project.id}><span class="choice-symbol">{['◈','⌘','▤','✳','▦','◇'][i % 6]}</span><span>{project.name}</span><span class="choice-arrow">↗</span></a>)}</div><p class="explorer-note">Ideas move between disciplines.<br/>That's where it gets interesting.</p></aside><div class="project-details">{projects.map((project,i)=><article id={`project-${project.id}`} class="project-panel" data-panel={project.id}><div class="panel-file"><span>{project.id} / overview</span><span>0{i+1}</span></div><div class="panel-content"><div class="project-kicker"><span>{project.category}</span><span class="stage">{project.stage}</span></div><h3>{project.name}<span>.</span></h3><p class="project-motto">{notes[project.id] || project.category}</p><p class="project-description">{project.description}</p><p class="project-detail">{project.detail}</p><div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div><div class="project-footer"><span class="footer-label">FROM THE WORKSPACE</span>{project.href ? <a href={project.href} target="_blank" rel="noopener noreferrer">Explore project ↗</a> : <a href={`mailto:${profile.email}?subject=${encodeURIComponent(`Let's talk about ${project.name}`)}`}>Ask me about it ↗</a>}</div></div></article>)}</div></div><div class="bench-status"><span><i></i> Built with curiosity</span><span>Rust · TypeScript · Python · Embedded</span></div></div></section>
<section id="about" class="about-section"><div><p class="eyebrow">02 / THE PERSON BEHIND THE PROJECTS</p><h2>At home in<br/>the in-between.</h2><div class="personal-card"><span class="personal-icon">✳</span><p>Off the keyboard</p><strong>Music. Bikes. Cats.</strong><span>Still following my curiosity.</span></div></div><div class="about-copy"><p class="lead">I like the space where software meets something tangible: a workflow, a community, a physical signal.</p><p>{profile.about}</p><p>{profile.community}</p><p>That curiosity has taken me from mobile applications and student software to simulated robot cooperation, browser tools, and custom electronics. The medium changes. The desire to make something useful stays.</p><div class="principles"><div><span>01</span><h3>Understand the system.</h3><p>Get close to the problem, from the interface down to the parts that make it work.</p></div><div><span>02</span><h3>Build for real use.</h3><p>Care about the workflow around the code, and the person on the other side.</p></div><div><span>03</span><h3>Stay curious.</h3><p>Make room for experiments across software, hardware, and creative tools.</p></div></div></div></section>
<section class="experience-section"><div class="section-heading"><div><p class="eyebrow">03 / EXPERIENCE & COMMUNITY</p><h2>Some context.</h2></div><a class="quiet" href="/resume.pdf" target="_blank">The résumé version ↗</a></div><div class="experience-list">{history.map(item=><div class="experience-row"><span class="experience-date">{item.date}</span><div><h3>{item.title}</h3><p>{item.text}</p></div><span class="experience-kind">{item.kind}</span></div>)}</div></section>
<section class="contact-section" id="contact"><p class="eyebrow">04 / START A CONVERSATION</p><div class="contact-grid"><h2>Have something<br/>on your mind<span>?</span></h2><div><p>A project, a tricky problem, or an interesting idea.<br/>I'd like to hear about it.</p><a class="primary" href={`mailto:${profile.email}`}>Let's talk <span>↗</span></a></div></div><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a></section>
</main><footer><a class="wordmark" href="#">ar<span>_</span></a><span>Amrit Rathie · Grapevine, Texas</span><div><a href={profile.github}>GitHub ↗</a><a href={profile.linkedin}>LinkedIn ↗</a><a href="/resume.pdf" target="_blank">Résumé ↗</a></div><a class="back-top" href="#">Back to top ↑</a></footer>
</div>
</Base>
<script>
const choices = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-project]'));
const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
function selectProject(id: string) {
 choices.forEach(choice => { const active = choice.dataset.project === id; choice.classList.toggle('is-active', active); if(active) choice.setAttribute('aria-current', 'true'); else choice.removeAttribute('aria-current'); });
 panels.forEach(panel => {panel.hidden = panel.dataset.panel !== id;});
}
choices.forEach(choice => choice.addEventListener('click', event => {event.preventDefault(); selectProject(choice.dataset.project!); history.replaceState(null, '', choice.hash);}));
const initial = location.hash.replace('#project-', '');
selectProject(panels.some(panel => panel.dataset.panel === initial) ? initial : 'powerpercept');
window.addEventListener('hashchange', () => {const id = location.hash.replace('#project-', ''); if(panels.some(panel => panel.dataset.panel === id)) selectProject(id);});
</script>
<style is:global>
