e-height:1.08;letter-spacing:-2px;margin-bottom:25px}.contact-grid h2 span{color:var(--accent)}.contact-grid p{font-size:14px;line-height:1.7;color:#b5c2aa}.email-link{font:12px monospace;color:var(--accent)}footer{padding:25px 0 35px;border-top:1px solid var(--line);display:flex;align-items:center;gap:28px}footer>span{font-size:10px;color:var(--muted)}footer>div{display:flex;gap:25px;margin-left:auto;font-size:11px}.back-top{font-size:10px;color:var(--muted);margin-left:15px}[hidden]{display:none!important}
