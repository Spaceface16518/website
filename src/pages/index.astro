---
import Base from '../layouts/Base.astro';
import { profile, projects, history } from '../data/profile';
---
<Base title="Amrit Rathie — Engineer, founder, curious by default">
<div class="page"><header><a class="brand" href="/" aria-label="Amrit Rathie home">ar<span>✳</span></a><nav aria-label="Main navigation"><a href="#work">Work</a><a href="#about">About</a><a class="nav-contact" href={`mailto:${profile.email}`}>Say hello <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><section class="hero"><p class="eyebrow"><span class="dot"></span> AMRIT RATHIE · GRAPEVINE, TEXAS</p><h1>Curious by default.<br/>An engineer<br/><em>by practice.</em></h1><div class="hero-bottom"><p>{profile.intro}</p><a class="round-link" href="#work" aria-label="Explore my work">↓</a></div><div class="hero-note"><span>SOFTWARE / HARDWARE / THE SPACE BETWEEN</span><span>01 — INTRODUCTION</span></div></section>
<section id="work" class="work"><div class="section-heading"><p class="eyebrow">A FEW THINGS I’M BUILDING</p><h2>Ideas, made tangible.</h2><p>From the systems behind financial services to the sensors beneath our feet.</p></div><div class="project-list">{projects.slice(0,6).map((project,i)=><article><div class="project-index">0{i+1}</div><div class="project-main"><span class="category">{project.category}</span><h3>{project.name}</h3><p>{project.description}</p><details><summary>More about this project <span aria-hidden="true">+</span></summary><p>{project.detail}</p><p class="tags">{project.tags.join(' / ')}</p>{project.href && <a href={project.href}>Explore project ↗</a>}</details></div><span class="stage">{project.stage}</span></article>)}</div></section>
<section id="about" class="about"><div><p class="eyebrow">A LITTLE ABOUT ME</p><h2>Depth of thought.<br/><em>Breadth of curiosity.</em></h2><div class="monogram" aria-hidden="true"><span>a</span><span>r</span><small>ALWAYS LEARNING</small></div></div><div class="about-copy"><p>{profile.about}</p><p>{profile.community}</p><p>{profile.personal}</p><a href={profile.github}>More experiments on GitHub ↗</a></div></section>
<section class="experience" aria-labelledby="experience-title"><div><p class="eyebrow">WHERE I’VE BEEN</p><h2 id="experience-title">A little context.</h2></div><div>{history.filter(h=>['Founder','Engineering','Education'].includes(h.kind)).map(item=><article><p class="date">{item.date}</p><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
<section class="contact" id="contact"><p class="eyebrow">GOOD THINGS START WITH A CONVERSATION</p><h2>What are you<br/><em>thinking about?</em></h2><a class="email" href={`mailto:${profile.email}`}>Let’s talk <span aria-hidden="true">↗</span></a></section></main><footer><span>© {new Date().getFullYear()} Amrit Rathie</span><div><a href={profile.github}>GitHub ↗</a><a href={profile.linkedin}>LinkedIn ↗</a><a href={`mailto:${profile.email}`}>Email ↗</a></div><span>Made with curiosity.</span></footer></div>
</Base>
<style is:global>
:root{--paper:#f7f7f0;--ink:#203d32;--muted:#596a5f;--line:#d7dcd2}body{background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.65}.page{max-width:1440px;padding:0 7%;margin:auto}header{display:flex;align-items:center;justify-content:space-between;padding:32px 0;border-bottom:1px solid var(--line)}.brand{font:italic 46px Georgia,serif;text-decoration:none;letter-spacing:-6px}.brand span{font:24px Arial;display:inline-block;transform:translate(8px,-14px)}nav{display:flex;align-items:center;gap:36px}nav a{text-decoration:none;font-size:14px}.nav-contact{border:1px solid var(--ink);padding:9px 20px;border-radius:99px}.hero{padding-top:68px}.eyebrow{font-size:11px;font-weight:600;letter-spacing:1.8px;display:flex;align-items:center;gap:9px}.dot{width:7px;height:7px;background:#608345;border-radius:50%}h1{font-size:clamp(58px,7.8vw,110px);line-height:1.03;font-weight:400;letter-spacing:-5px;margin:35px 0 32px}em{font-family:Georgia,'Times New Roman',serif;font-weight:400}h1 em{color:#70855c}.hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:40px}.hero-bottom p{font-size:18px;max-width:540px;margin:0;line-height:1.7}.round-link{width:66px;height:66px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;text-decoration:none;font-size:27px;flex-shrink:0}.round-link:hover,.nav-contact:hover{background:var(--ink);color:var(--paper)}.hero-note{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:58px;padding:18px 0;font-size:9px;letter-spacing:1.6px;color:var(--muted)}.work{padding:86px 0}.section-heading{max-width:550px;margin-bottom:38px}h2{font-size:clamp(35px,4vw,53px);line-height:1.12;letter-spacing:-1.6px;font-weight:400;margin:18px 0 24px}.section-heading>p:last-child{color:var(--muted)}.project-list article{display:grid;grid-template-columns:60px 1fr 180px;padding:32px 0;border-top:1px solid var(--line);gap:22px}.project-index{font:12px monospace;padding-top:4px;color:var(--muted)}.category{font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted)}h3{font-size:25px;font-weight:400;letter-spacing:-.6px;margin:7px 0 10px}.project-main>p{max-width:550px;color:var(--muted);margin-bottom:12px}.stage{font-size:10px;text-align:right;color:var(--muted);padding-top:5px}details{max-width:550px;font-size:14px}summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;max-width:220px;padding:8px 0}summary::-webkit-details-marker{display:none}details[open] summary span{transform:rotate(45deg)}details>p{margin:14px 0}.tags{font:11px monospace;color:var(--muted)}.about{padding:68px 0 86px;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:10%}.about-copy{padding-top:55px;font-size:17px}.about-copy p{margin-bottom:22px}.about-copy a{font-size:14px;text-underline-offset:6px}.monogram{position:relative;height:225px;width:220px;margin-top:38px;display:flex;align-items:center;justify-content:center;background:#e7ebdf;border-radius:50%}.monogram>span{font:italic 150px Georgia;letter-spacing:-23px;line-height:1}.monogram>span:nth-child(2){color:#798a65}.monogram small{position:absolute;bottom:24px;font-size:8px;letter-spacing:2.5px}.experience{display:grid;grid-template-columns:1fr 1fr;gap:10%;border-top:1px solid var(--line);padding:65px 0}.experience article{border-bottom:1px solid var(--line);padding:20px 0}.experience article:first-child{padding-top:0}.date{font:10px monospace;color:var(--muted);text-transform:uppercase}.experience h3{font-size:19px}.experience article>p:last-child{font-size:14px;color:var(--muted)}.contact{background:var(--ink);color:var(--paper);padding:65px 8%;margin:20px 0 60px}.contact h2{font-size:clamp(40px,5.5vw,74px);margin:30px 0}.email{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #78887b;padding-top:24px;text-decoration:none;font-size:20px}.email span{font-size:35px}footer{font-size:11px;display:flex;justify-content:space-between;gap:20px;padding-bottom:30px;color:var(--muted)}footer div{display:flex;gap:22px}footer a{text-decoration:none}@media(max-width:700px){.page{padding:0 6%}header{padding:22px 0}nav{gap:17px}nav a{font-size:12px}.nav-contact{padding:7px 11px}.hero{padding-top:44px}h1{font-size:61px;letter-spacing:-3px}.hero-bottom p{font-size:16px}.round-link{width:44px;height:44px}.hero-note span:last-child{display:none}.hero-note{font-size:8px}.work{padding:55px 0}.project-list article{grid-template-columns:26px 1fr;gap:12px}.stage{grid-column:2;text-align:left}.about,.experience{grid-template-columns:1fr;gap:20px}.about-copy{padding-top:0}.monogram{display:none}.about{padding:50px 0}.contact{padding:36px 25px}.contact .eyebrow{font-size:8px}footer{flex-wrap:wrap}footer>span:last-child{display:none}}@media(max-width:370px){h1{font-size:51px}.hero-bottom{gap:16px}}
</style>
