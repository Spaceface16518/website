---
import Base from '../layouts/Base.astro';
import {profile, projects, history} from '../data/profile';
const groups = ['All disciplines','Hardware','Software','AI & research'];
function group(id: string) {return id==='powerpercept'?'Hardware':['cloudcare','locking','swarm','creative'].includes(id)?'AI & research':'Software'}
---
<Base title="Amrit Rathie — The working lab">
<div class="lab"><header><a class="logo" href="/">AR<span class="logo-square">↗</span></a><span class="header-label">PERSONAL RESEARCH & ENGINEERING</span><nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#about">Profile</a><a href={`mailto:${profile.email}`}>Contact ↗</a></nav></header>
<main id="main"><section class="intro"><div class="intro-copy"><p class="label">FIELD NOTES / AMRIT RATHIE</p><h1>Good questions.<br/>Real systems.</h1><p class="lede">I follow ideas from the first principle<br class="desktop"/> to the working prototype.</p><p class="bio">{profile.intro}</p><a class="button" href="#projects">Explore the lab <span aria-hidden="true">↓</span></a></div><div class="diagram" aria-label="Conceptual diagram connecting sensing, systems, and experience"><div class="diagram-meta"><span>FIG. 01 / PRACTICE</span><span>SCHEMATIC</span></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="axis x-axis"></div><div class="axis y-axis"></div><div class="diagram-core">IDEA<br/><span>→ REALITY</span></div><div class="node node-a"><span>01</span>SENSE<small>Hardware & data</small></div><div class="node node-b"><span>02</span>BUILD<small>Systems & software</small></div><div class="node node-c"><span>03</span>CONNECT<small>People & experiences</small></div><div class="diagram-foot">A practice across disciplines.</div></div></section>
<div class="status-bar"><span><b class="status-dot"></b> CURRENT PURSUITS</span><span>POWERPERCEPT <b>Founder & CTO</b></span><span>FIDELITY INVESTMENTS <b>Full-Stack Engineer</b></span></div>
<section id="projects"><div class="section-top"><div><p class="label">01 / PROJECT INDEX</p><h2>Things in the world.<br/>Ideas in motion.</h2></div><p>Different problems. Shared habits:<br/>understand, prototype, test, refine.</p></div><div class="filters" role="group" aria-label="Filter projects by discipline" hidden>{groups.map((g,i)=><button type="button" data-filter={g} aria-pressed={i===0}>{g}</button>)}<span id="result-count" aria-live="polite">{projects.length} projects</span></div><div class="project-grid">{projects.map((p,i)=><article data-group={group(p.id)}><div class="card-top"><span>EXP. {String(i+1).padStart(2,'0')}</span><span>{p.category}</span></div><div class={`glyph glyph-${i%4}`} aria-hidden="true"><span></span><span></span><span></span><span></span></div><p class="project-stage">{p.stage}</p><h3>{p.name}</h3><p>{p.description}</p><details><summary>Read field notes <span aria-hidden="true">+</span></summary><p>{p.detail}</p>{p.href && <a href={p.href}>View project ↗</a>}</details><div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div></article>)}</div></section>
<section class="practice"><p class="label">02 / HOW I WORK</p><div class="practice-grid"><h2>The interesting part<br/>is where disciplines<br/><em>meet.</em></h2><div><article><span>01 — UNDERSTAND THE SYSTEM</span><p>From pressure sensors to financial data pipelines, the details shape the experience.</p></article><article><span>02 — BUILD THROUGH THE STACK</span><p>Custom hardware, embedded firmware, cloud services, and interfaces are all part of the same problem.</p></article><article><span>03 — MAKE ROOM FOR EXPLORATION</span><p>Research, hackathons, and small tools are a way to ask better questions — and keep learning.</p></article></div></div></section>
<section id="about" class="profile"><div><p class="label">03 / THE PERSON BEHIND THE WORK</p><h2>Hi, I’m Amrit.</h2><p>{profile.about}</p><p>{profile.community}</p><p>{profile.personal}</p><a href={profile.github}>Open the GitHub archive ↗</a></div><aside><p class="label">SELECTED EXPERIENCE</p>{history.filter(h=>['Founder','Engineering','Education'].includes(h.kind)).map(h=><article><span>{h.date}</span><h3>{h.title}</h3><p>{h.text}</p></article>)}</aside></section>
<section class="contact"><p class="label">04 / START A CONVERSATION</p><h2>Working on an<br/>interesting problem?</h2><a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></section></main><footer><span>AMRIT RATHIE / GRAPEVINE, TX</span><div><a href={profile.github}>GitHub</a><a href={profile.linkedin}>LinkedIn</a><a href="#main">Back to top ↑</a></div><span>© {new Date().getFullYear()}</span></footer></div>
</Base>
<script>
const filters = document.querySelector<HTMLElement>('.filters');
if (filters) filters.hidden = false;
const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{
 const selected=button.dataset.filter;
 document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
 let count=0;
 cards.forEach(card=>{card.hidden=selected!=='All disciplines'&&card.dataset.group!==selected;if(!card.hidden)count++;});
 const result=document.getElementById('result-count');if(result) result.textContent=`${count} ${count===1?'project':'projects'}`;
}));
</script>
<style is:global>
:root{--ink:#102f66;--blue:#1c50dd;--paper:#fafbf6;--line:#cbd5e3}body{background:var(--paper);color:var(--ink);font:16px/1.65 Arial,Helvetica,sans-serif}.lab{max-width:1600px;padding:0 5%;margin:auto}header{display:flex;align-items:center;gap:35px;padding:25px 0;border-bottom:1px solid var(--ink)}.logo{font-size:25px;font-weight:800;letter-spacing:-2px;text-decoration:none;display:flex;align-items:center;gap:8px}.logo-square{background:var(--blue);color:white;width:25px;height:25px;font-size:22px;display:grid;place-items:center;font-weight:400}.header-label{font:9px monospace;letter-spacing:1.5px}nav{margin-left:auto;display:flex;gap:30px;font-size:12px}nav a{text-decoration:none}.intro{display:grid;grid-template-columns:1.05fr 1fr;gap:35px;padding:65px 0 55px;align-items:center}.label{font:10px monospace;letter-spacing:1.5px}h1{font-size:clamp(52px,5.9vw,87px);font-weight:500;letter-spacing:-4px;line-height:1.04;margin:27px 0}.lede{font-size:23px;line-height:1.5;letter-spacing:-.5px}.bio{font-size:14px;max-width:470px;color:#4a5f7e}.button{display:inline-flex;background:var(--blue);color:white;align-items:center;justify-content:space-between;gap:60px;text-decoration:none;font-size:12px;padding:15px 20px;margin-top:12px}.diagram{height:460px;position:relative;overflow:hidden;border:1px solid var(--line);background-image:radial-gradient(#b7c8e7 1px,transparent 1px);background-size:16px 16px}.diagram-meta{position:absolute;top:16px;left:18px;right:18px;display:flex;justify-content:space-between;font:9px monospace}.orbit{position:absolute;border:1px solid #96b0de;border-radius:50%;width:280px;height:280px;top:95px;left:calc(50% - 140px)}.orbit-two{width:365px;height:365px;left:calc(50% - 182px);top:52px;border-style:dashed}.axis{position:absolute;background:#b9c9e0}.x-axis{height:1px;top:50%;width:100%}.y-axis{width:1px;left:50%;height:100%}.diagram-core{position:absolute;top:calc(50% - 45px);left:calc(50% - 60px);background:var(--blue);color:white;width:120px;height:90px;display:flex;flex-direction:column;align-items:center;justify-content:center;font:19px monospace}.diagram-core span{font-size:11px;margin-top:7px}.node{position:absolute;padding:10px 14px;background:var(--paper);border:1px solid var(--ink);font:12px monospace;min-width:140px}.node>span{display:block;font-size:8px;color:var(--blue);margin-bottom:7px}.node small{display:block;font:10px Arial;margin-top:7px}.node-a{top:60px;left:25px}.node-b{right:15px;top:190px}.node-c{bottom:43px;left:38px}.diagram-foot{position:absolute;bottom:11px;right:14px;font:9px monospace}.status-bar{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;padding:19px 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);font:9px monospace;letter-spacing:.3px}.status-bar>span{display:flex;gap:12px;align-items:center}.status-bar b{font-weight:400;color:#566a88}.status-dot{height:6px;width:6px;background:var(--blue);border-radius:50%}#projects{padding:72px 0}.section-top{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:34px}h2{font-size:clamp(34px,4vw,54px);font-weight:400;letter-spacing:-2px;line-height:1.1;margin:20px 0}.section-top>p{font-size:13px;color:#4a5f7e}.filters{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:27px 0}.filters[hidden]{display:none}.filters button{border:1px solid var(--line);background:transparent;color:var(--ink);padding:9px 14px;font-size:11px}.filters button[aria-pressed=true]{background:var(--ink);color:white;border-color:var(--ink)}#result-count{font:10px monospace;margin-left:auto}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.project-grid>article{padding:24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column}.project-grid>article[hidden]{display:none}.card-top{display:flex;gap:12px;justify-content:space-between;font:9px monospace}.glyph{height:120px;margin:15px 0 20px;display:flex;align-items:center;justify-content:center;gap:5px;overflow:hidden}.glyph span{width:40px;height:70px;border:1px solid var(--blue);transform:skewY(-20deg)}.glyph span:nth-child(2){background:var(--blue)}.glyph-1 span{border-radius:50%;width:60px;height:60px;transform:none;margin:0 -10px}.glyph-2 span{height:20px;transform:rotate(-45deg);background:#b6c8f1}.glyph-2 span:nth-child(2){height:70px;background:var(--blue)}.glyph-3 span{transform:rotate(45deg);width:45px;height:45px;margin:0 -8px}.project-stage{font:9px monospace;color:#536783}h3{font-size:25px;letter-spacing:-1px;font-weight:500;line-height:1.2;margin:0 0 14px}.project-grid article>p:not(.project-stage){font-size:14px;color:#4a5f7e}details{font-size:13px;margin-bottom:18px}summary{padding:8px 0;display:flex;justify-content:space-between;cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}details[open] summary span{transform:rotate(45deg)}details p{margin-top:12px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:16px}.tags span{font:9px monospace;border:1px solid var(--line);padding:4px 6px}.practice{background:var(--ink);color:white;padding:45px 5%;margin-bottom:65px}.practice-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.practice h2{font-size:43px}.practice em{font-family:Georgia;font-weight:400;color:#afc4ff}.practice article{padding:18px 0;border-bottom:1px solid #526a93}.practice article>span{font:9px monospace;letter-spacing:1px;color:#c3d0eb}.practice article>p{font-size:14px;margin:12px 0}.profile{display:grid;grid-template-columns:1fr 1fr;gap:10%;padding:20px 0 70px}.profile>div>p:not(.label){font-size:16px;color:#4a5f7e}.profile a{font-size:13px;text-underline-offset:5px}.profile aside{border:1px solid var(--line);padding:28px}.profile aside article{border-top:1px solid var(--line);padding:16px 0}.profile aside article:last-child{padding-bottom:0}.profile aside article>span{font:9px monospace}.profile aside h3{font-size:17px;margin:9px 0;letter-spacing:-.2px}.profile aside article p{font-size:12px;margin:0;color:#4a5f7e}.contact{border-top:1px solid var(--ink);padding:45px 0 70px}.contact h2{font-size:clamp(45px,6vw,80px)}.contact>a{font-size:20px;text-decoration:none;display:flex;justify-content:space-between;max-width:700px;border-bottom:1px solid var(--blue);padding:20px 0}.contact>a>span{font-size:30px}footer{border-top:1px solid var(--line);padding:25px 0;display:flex;justify-content:space-between;gap:20px;font:9px monospace}footer div{display:flex;gap:20px}footer a{text-decoration:none}@media(max-width:1000px){.header-label{display:none}.project-grid{grid-template-columns:repeat(2,1fr)}.intro{gap:25px}.diagram{height:400px}.node{min-width:120px}.node-b{right:10px;top:160px}.node-c{left:20px}.orbit{top:60px}.orbit-two{top:18px}}@media(max-width:700px){.lab{padding:0 6%}nav{gap:20px}.intro{grid-template-columns:1fr;padding-top:40px}.diagram{height:340px}.intro h1{font-size:57px;letter-spacing:-3px}.lede{font-size:20px}.bio{font-size:15px}.diagram-core{left:calc(50% - 60px)}.node-a{top:45px;left:20px}.node-b{top:135px}.node-c{bottom:35px}.orbit{top:28px}.orbit-two{top:-14px}.status-bar{gap:16px}.status-bar>span{width:100%}.section-top{display:block}.section-top>p{margin-top:20px}.project-grid{grid-template-columns:1fr}.glyph{height:100px}.project-grid h3{font-size:29px}.practice-grid,.profile{grid-template-columns:1fr;gap:24px}.practice{padding:30px 24px}.practice h2{font-size:36px}.profile aside{padding:22px}.contact>a{font-size:16px}footer{flex-wrap:wrap}.filters button{padding:8px 9px;font-size:10px}#result-count{width:100%;margin-top:7px}}
</style>
