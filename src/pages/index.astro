---
import Base from '../layouts/Base.astro';
import { profile, projects, history } from '../data/profile';
const currentProjects = projects.filter(p => ['powerpercept', 'headershim', 'dsupload', 'creative'].includes(p.id));
const earlierHistory = history.slice(1).filter(item => item.date !== 'Recent work');
const chapterProject = (title: string) => title.includes('B.S.') ? projects.find(p => p.id === 'cloudcare') : title.includes('EXPANSIA') ? projects.find(p => p.id === 'locking') : null;
---
<Base title="Amrit Rathie — A curious path through software">
  <header class="site-header wrap">
    <a class="wordmark" href="#" aria-label="Amrit Rathie home"><span class="monogram">ar.</span><span>AMRIT RATHIE</span></a>
    <nav aria-label="Main navigation"><a href="#journey">The journey</a><a href="#about">About me</a><a class="nav-contact" href="#contact">Say hello <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-top"><p class="eyebrow">SOFTWARE · SYSTEMS · SMALL EXPERIMENTS</p><p class="location"><span aria-hidden="true">◈</span> Grapevine, Texas</p></div>
      <div class="hero-grid">
        <div><h1 id="hero-title">A curious path.<br/>An <em>open</em><br/>notebook.</h1><p class="hero-intro">I'm Amrit — a software engineer at Fidelity Investments and the founder & CTO of POWERPERCEPT. I follow interesting questions and build things that make them real.</p><a class="journey-link" href="#journey">Follow the thread <span aria-hidden="true">↓</span></a></div>
        <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="orbit-center">a<span>r</span></div><span class="art-label label-one">CODE</span><span class="art-label label-two">CURIOSITY</span><span class="art-label label-three">CONNECTION</span><span class="art-dot dot-one"></span><span class="art-dot dot-two"></span><div class="art-caption">01 / ALWAYS IN THE MAKING</div></div>
      </div>
      <div class="hero-footer"><span>A PERSONAL FIELDNOTE</span><span>SCROLL TO EXPLORE <span aria-hidden="true">↓</span></span></div>
    </section>
    <section id="journey" class="journey wrap" aria-labelledby="journey-title">
      <div class="section-heading"><span class="eyebrow">01 / THE JOURNEY</span><h2 id="journey-title">One question leads<br/>to <em>the next.</em></h2><p>From a first mobile app to systems that sense the physical world. A few stops along the way, starting with what I've been exploring lately.</p></div>
      <div class="timeline">
        <article class="timeline-entry current">
          <div class="date-column"><span class="timeline-dot"></span><span class="date">2025–present</span><span class="date-note">FOUNDER & BUILDER</span></div>
          <div class="entry-body"><div class="chapter"><span>CHAPTER 08</span><span>POWERPERCEPT & INDEPENDENT WORK</span></div><h3>Bringing ideas<br/>into the world.</h3><p class="entry-intro">Since February 2025, I’ve been building POWERPERCEPT as founder & CTO. Alongside it, I explore developer tools, desktop software, and creative computing. The medium changes. The curiosity stays.</p>
            <div class="project-grid">{currentProjects.map((project, i) => <article class="project-card"><div class="project-meta"><span class="project-number">0{i + 1}</span><span>{project.category}</span></div><h4>{project.name}</h4><p>{project.description}</p><p class="project-detail">{project.detail}</p><ul class="tags" aria-label={`${project.name} technologies`}>{project.tags.map(tag => <li>{tag}</li>)}</ul></article>)}</div>
          </div>
        </article>
        {earlierHistory.map((item, i) => <article class="timeline-entry"><div class="date-column"><span class="timeline-dot"></span><span class="date">{item.date}</span><span class="date-note">{item.kind}</span></div><div class="entry-body"><div class="chapter"><span>CHAPTER {String(earlierHistory.length - i).padStart(2, '0')}</span><span>{item.kind.toUpperCase()}</span></div><h3>{item.title}</h3><p class="history-text">{item.text}</p>{chapterProject(item.title) && <aside class="milestone"><p class="eyebrow">ALSO ALONG THE WAY · {chapterProject(item.title)?.stage}</p><h4>{chapterProject(item.title)?.name}</h4><p>{chapterProject(item.title)?.description}</p><p>{chapterProject(item.title)?.detail}</p><a class="text-link" href={chapterProject(item.title)?.href ?? '#journey'}>Explore the project <span aria-hidden="true">↗</span></a></aside>}{item.title.includes('Degree Planner') && <a class="text-link" href="https://www.utdnebula.com/projects/planner">Explore Degree Planner <span aria-hidden="true">↗</span></a>}{item.title.includes('Swarm') && <div class="research-note"><span aria-hidden="true">↳</span><p>An enduring question: how do simple rules become complex, collective behavior?</p></div>}</div></article>)}
        <div class="timeline-end"><span aria-hidden="true">✳</span><p>Every project starts with a question.</p></div>
      </div>
    </section>
    <section id="about" class="about-section" aria-labelledby="about-title"><div class="wrap about-grid"><div><p class="eyebrow">02 / THE PERSON BEHIND THE PROJECTS</p><h2 id="about-title">Still learning.<br/>Still <em>curious.</em></h2><div class="about-mark" aria-hidden="true">✳</div></div><div class="about-copy"><p class="large-copy">{profile.about}</p><p>{profile.community}</p><p>{profile.personal}</p><dl class="interests"><div><dt>Interested in</dt><dd>Systems, languages & useful products</dd></div><div><dt>Often working with</dt><dd>Rust, TypeScript, Python & hardware</dd></div><div><dt>Outside the editor</dt><dd>Music, biking & cats</dd></div></dl><a class="text-link" href={profile.linkedin}>Professional profile <span aria-hidden="true">↗</span></a></div></div></section>
    <section id="contact" class="contact wrap" aria-labelledby="contact-title"><p class="eyebrow">03 / THE NEXT CONVERSATION</p><div class="contact-grid"><h2 id="contact-title">What are you<br/><em>curious about?</em></h2><div><p>Have an interesting project, a shared question, or just want to talk shop? I'd love to hear from you.</p><a class="email-link" href={`mailto:${profile.email}`}>Say hello <span aria-hidden="true">↗</span></a><span class="email-address">{profile.email}</span></div></div></section>
  </main>
  <footer class="site-footer wrap"><span>Amrit Rathie <span class="footer-place">/ Grapevine, TX</span></span><div><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href="#">Back to top ↑</a></div></footer>
</Base>
<style is:global>
:root{--paper:#f6f2e9;--ink:#2c3029;--muted:#65665a;--rust:#984d30;--line:#d6d1c4;--serif:Georgia,'Times New Roman',serif;--sans:Arial,Helvetica,sans-serif}body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6}::selection{background:#ddba92;color:var(--ink)}.wrap{max-width:1280px;width:calc(100% - 112px);margin-inline:auto}.site-header{height:112px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.wordmark{display:flex;align-items:center;gap:18px;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:2px}.monogram{font:italic 37px var(--serif);letter-spacing:-4px;width:45px}.site-header nav{display:flex;align-items:center;gap:34px;font-size:12px}.site-header nav a{text-decoration:none}.site-header nav a:hover,.site-footer a:hover{color:var(--rust);text-decoration:underline;text-underline-offset:5px}.nav-contact{border-bottom:1px solid var(--ink);padding-bottom:5px}.nav-contact span{margin-left:20px}.hero{padding-top:42px}.hero-top{display:flex;justify-content:space-between;align-items:center}.eyebrow{font-size:10px;line-height:1.7;letter-spacing:1.8px;font-weight:700}.location{font-size:11px;letter-spacing:.3px}.location span{margin-right:8px;color:var(--rust)}.hero-grid{display:grid;grid-template-columns:1.25fr 1fr;align-items:center;padding:42px 0 65px;gap:30px}h1{font:clamp(66px,7.1vw,106px)/.99 var(--serif);letter-spacing:-5px;margin-bottom:28px;font-weight:400}em{font-weight:400;color:var(--rust)}.hero-intro{font-size:17px;line-height:1.75;max-width:395px;color:var(--muted);margin-bottom:26px}.journey-link{font-size:12px;font-weight:600;text-decoration:none;display:inline-flex;gap:30px;align-items:center}.journey-link span{border:1px solid #b9b7a9;display:grid;place-items:center;width:33px;height:33px;border-radius:50%;font-size:17px;transition:transform .2s}.journey-link:hover span{transform:translateY(4px)}.hero-art{height:400px;position:relative;margin-bottom:30px}.orbit{position:absolute;width:310px;height:310px;left:50%;top:46%;border:1px solid #aaa58f;border-radius:50%;transform:translate(-50%,-50%)}.orbit-one{width:340px;height:210px;transform:translate(-50%,-50%) rotate(-40deg)}.orbit-two{width:340px;height:210px;transform:translate(-50%,-50%) rotate(40deg)}.orbit-three{width:220px;height:330px;transform:translate(-50%,-50%) rotate(0deg)}.orbit-center{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);font:italic 132px var(--serif);letter-spacing:-22px;padding-right:18px;color:var(--rust)}.orbit-center span{color:var(--ink)}.art-label{position:absolute;font-size:9px;letter-spacing:1.8px;background:var(--paper);padding:5px}.label-one{top:0;left:44%}.label-two{bottom:82px;left:0}.label-three{right:-8px;bottom:108px}.art-dot{width:9px;height:9px;border-radius:50%;background:var(--rust);position:absolute}.dot-one{top:132px;left:57px}.dot-two{bottom:88px;right:88px}.art-caption{position:absolute;bottom:0;width:100%;text-align:center;font-size:9px;letter-spacing:2px;color:var(--muted)}.hero-footer{border-top:1px solid var(--line);padding:20px 0;display:flex;justify-content:space-between;font-size:9px;letter-spacing:1.5px;color:var(--muted)}.hero-footer span span{margin-left:15px}.journey{padding-top:105px;padding-bottom:90px}.section-heading{display:grid;grid-template-columns:190px 1fr 300px;gap:35px;align-items:start;margin-bottom:70px}.section-heading .eyebrow{padding-top:8px}.section-heading h2,h2{font:48px/1.1 var(--serif);letter-spacing:-1.8px;font-weight:400}.section-heading>p{color:var(--muted);font-size:13px;line-height:1.9;padding-top:5px}.timeline-entry{display:grid;grid-template-columns:190px 1fr;gap:35px}.date-column{position:relative;border-right:1px solid var(--line);padding:0 28px 65px 0}.timeline-dot{position:absolute;width:9px;height:9px;border-radius:50%;background:var(--rust);right:-5px;top:6px;box-shadow:0 0 0 7px var(--paper)}.date{display:block;font:27px/1.15 var(--serif);letter-spacing:-.5px}.date-note{display:block;font-size:8px;font-weight:700;letter-spacing:1.4px;color:var(--muted);margin-top:15px;text-transform:uppercase}.entry-body{padding:0 0 60px 24px}.chapter{display:flex;gap:20px;font-size:8px;letter-spacing:1.5px;color:var(--rust);font-weight:600;margin-bottom:18px}.chapter span+span{color:var(--muted)}.entry-body h3{font:32px/1.2 var(--serif);letter-spacing:-.7px;font-weight:400;margin-bottom:16px}.current .entry-body h3{font-size:48px;letter-spacing:-1.3px}.entry-intro{max-width:550px;font-size:14px;color:var(--muted);margin-bottom:28px}.project-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.project-card{border:1px solid var(--line);padding:27px 25px 22px;background:#efebe0}.project-card:first-child{background:#e5e6d9}.project-card:nth-child(4){background:#eadfd0}.project-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:8px;letter-spacing:.8px;color:var(--muted);margin-bottom:30px}.project-number{font:italic 22px var(--serif);color:var(--rust)}.project-card h4{font:25px/1.2 var(--serif);letter-spacing:-.5px;margin:0 0 14px}.project-card p{font-size:12px;line-height:1.8;margin-bottom:14px}.project-card .project-detail{font-size:11px;color:var(--muted)}.tags{list-style:none;padding:14px 0 0;margin:18px 0 0;border-top:1px solid #cbc7b8;display:flex;flex-wrap:wrap;gap:7px 13px;font-size:8px;letter-spacing:.3px}.milestone{background:#eeeadf;border-left:2px solid var(--rust);padding:22px 25px;margin-top:25px;max-width:650px}.milestone h4{font:24px var(--serif);margin:12px 0}.milestone>p:not(.eyebrow){font-size:13px;line-height:1.8;color:var(--muted)}.history-text,.entry-extra{font-size:14px;max-width:650px;line-height:1.9}.history-text{margin-bottom:12px}.entry-extra{color:var(--muted)}.text-link{font-size:12px;text-decoration:underline;text-underline-offset:6px;display:inline-block;margin-top:12px}.text-link span{margin-left:15px}.research-note{border-left:2px solid var(--rust);padding:15px 20px;margin-top:24px;background:#eee9df;display:flex;gap:15px;max-width:580px}.research-note>span{color:var(--rust)}.research-note p{font:italic 20px/1.5 var(--serif);margin:0}.timeline-end{margin-left:167px;display:flex;gap:30px;align-items:center}.timeline-end>span{display:grid;place-items:center;width:46px;height:46px;border:1px solid var(--line);border-radius:50%;font-size:25px;color:var(--rust);flex-shrink:0}.timeline-end p{margin:0;font:italic 19px var(--serif);color:var(--muted)}.about-section{background:#e9e6db;padding:85px 0}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.about-grid h2{font-size:62px;margin-top:25px}.about-mark{font-size:100px;line-height:1.4;color:var(--rust)}.about-copy{padding-top:10px;color:var(--muted);font-size:14px}.about-copy .large-copy{font-size:18px;line-height:1.9;color:var(--ink);margin-bottom:22px}.interests{margin:32px 0 22px}.interests>div{border-top:1px solid #ccc9bd;display:grid;grid-template-columns:145px 1fr;gap:12px;padding:13px 0;font-size:11px}.interests dt{color:var(--muted)}.interests dd{margin:0;color:var(--ink)}.contact{padding-block:95px}.contact-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:90px;margin-top:25px;align-items:center}.contact-grid h2{font-size:62px;margin:0}.contact-grid p{font-size:14px;color:var(--muted);max-width:360px}.email-link{display:inline-flex;align-items:center;gap:55px;font:25px var(--serif);border-bottom:1px solid var(--rust);text-decoration:none;padding-bottom:12px;margin-top:10px;color:var(--rust)}.email-address{display:block;font-size:11px;color:var(--muted);margin-top:15px}.site-footer{border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:25px;padding-block:25px 35px;font-size:10px}.footer-place{color:var(--muted);margin-left:12px}.site-footer>div{display:flex;gap:27px}.site-footer a{text-decoration:none}
@media(min-width:1500px){.hero-grid{padding-block:65px 85px}.hero-art{transform:scale(1.1)}}
@media(max-width:1050px){.wrap{width:calc(100% - 64px)}.section-heading{grid-template-columns:145px 1fr 230px;gap:25px}.timeline-entry{grid-template-columns:145px 1fr;gap:25px}.entry-body{padding-left:15px}.timeline-end{margin-left:122px}.hero-art{transform:scale(.85);transform-origin:center}.hero-grid{grid-template-columns:1.2fr 1fr;gap:0}.about-grid{gap:50px}.contact-grid{gap:40px}.project-card{padding:22px 18px}.section-heading h2{font-size:39px}}
@media(max-width:760px){.wrap{width:calc(100% - 40px)}.site-header{height:86px}.wordmark{gap:10px;font-size:9px;letter-spacing:1.1px}.monogram{font-size:31px;width:32px}.site-header nav{gap:18px;font-size:11px}.site-header nav>a:nth-child(2){display:none}.nav-contact span{margin-left:6px}.hero{padding-top:28px}.hero-top{display:block}.eyebrow{font-size:9px;letter-spacing:1.1px}.location{margin-bottom:0}.hero-grid{grid-template-columns:1fr;padding-top:35px;padding-bottom:25px;position:relative}.hero h1{font-size:78px;letter-spacing:-4px;position:relative;z-index:1}.hero-intro{font-size:16px;max-width:380px}.hero-art{height:300px;width:320px;justify-self:center;margin:30px 0 0;transform:scale(.8)}.art-caption{bottom:-30px}.label-one{top:-40px}.label-two{left:-22px;bottom:30px}.label-three{right:-46px;bottom:53px}.dot-one{top:90px;left:7px}.dot-two{right:52px;bottom:14px}.hero-footer{font-size:8px;letter-spacing:.7px}.journey{padding-top:65px;padding-bottom:55px}.section-heading{display:block;margin-bottom:40px}.section-heading h2{font-size:43px;margin:22px 0 20px}.section-heading>p{max-width:430px}.timeline-entry{grid-template-columns:1fr;gap:0;border-left:1px solid var(--line);margin-left:5px;padding-left:23px}.date-column{border:0;padding:0 0 22px}.timeline-dot{left:-28px;right:auto;top:9px}.date{font:22px var(--serif)}.date br{display:none}.date br::after{content:' '}.date-note{font-size:8px;margin-top:6px}.entry-body{padding-left:0;padding-bottom:48px}.current .entry-body h3{font-size:38px}.entry-body h3{font-size:27px}.chapter{font-size:7px;gap:14px;margin-bottom:14px}.project-grid{grid-template-columns:1fr}.project-card{padding:25px}.project-meta{margin-bottom:20px}.project-card h4{font-size:27px}.project-card p{font-size:13px}.project-card .project-detail{font-size:12px}.tags{font-size:9px}.timeline-end{margin-left:-17px;gap:16px}.timeline-end p{font-size:16px}.about-section{padding:55px 0}.about-grid{grid-template-columns:1fr;gap:20px}.about-grid h2{font-size:49px;margin-bottom:15px}.about-mark{display:none}.about-copy .large-copy{font-size:17px}.interests>div{grid-template-columns:120px 1fr;font-size:10px}.contact{padding-block:58px}.contact-grid{grid-template-columns:1fr;gap:24px}.contact-grid h2{font-size:49px}.site-footer{flex-direction:column;gap:18px;font-size:10px}.site-footer>div{gap:25px}}
@media(max-width:380px){.hero h1{font-size:65px}.hero-art{width:280px;transform:scale(.7)}.site-header nav{gap:12px}.wordmark>span+span{max-width:52px;font-size:8px}.contact-grid h2{font-size:44px}}
</style>
