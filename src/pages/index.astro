---
import Base from '../layouts/Base.astro';
import { profile, projects, history } from '../data/profile';
const featured = projects[0];
---
<Base title="Amrit Rathie — A practice in making">
  <div class="page">
    <header class="masthead"><a class="wordmark" href="#">Amrit Rathie<span>Software, systems & the spaces between.</span></a><nav aria-label="Main navigation"><a href="#work">Selected work</a><a href="#about">About</a><a href="#contact">Get in touch ↗</a></nav></header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="issue"><span>Independent thinking. Practical making.</span><span>{profile.location}</span></div>
        <h1 id="hero-title">A practice<br/>in <em>making.</em><span class="asterisk" aria-hidden="true">✳</span></h1>
        <div class="hero-bottom"><p class="eyebrow">The portfolio of<br/>{profile.name}</p><p>{profile.intro}</p><a class="circle-link" href="#work" aria-label="Explore selected work">↓</a></div>
      </section>
      <section id="work" class="work" aria-labelledby="work-title">
        <div class="section-line"><h2 id="work-title">Selected work</h2><span>01 — {String(projects.length).padStart(2, '0')} / Ideas put into practice</span></div>
        <article class="feature">
          <div class="feature-copy"><span class="eyebrow">01 / {featured.category}</span><h3>{featured.name}<span>Reading the<br/><em>physical world.</em></span></h3><p>{featured.description}</p><p class="detail">{featured.detail}</p><ul class="tags">{featured.tags.map(tag => <li>{tag}</li>)}</ul><span class="status">{featured.stage}</span></div>
          <div class="pressure-art" role="img" aria-label="Abstract illustration of pressure sensing: concentric contours and sample points over a measurement grid"><div class="art-top"><span>FIELD STUDY / 001</span><span>PRESSURE → DATA</span></div><svg viewBox="0 0 520 560" aria-hidden="true"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="#fff" stroke-opacity=".14" stroke-width="1"/></pattern></defs><rect width="520" height="560" fill="url(#grid)"/><g fill="none" stroke="#f1d1a7" stroke-width="1.3"><path d="M178 468C70 435 90 328 138 258S130 121 216 77s178 35 170 115-82 109-58 177-47 129-150 99Z"/><path d="M192 440c-84-28-73-108-32-168s2-121 68-158 127 27 125 83-78 107-55 170-27 97-106 73Z"/><path d="M200 406c-52-22-46-78-14-127s15-97 51-125 84 17 85 49-78 103-52 167-29 48-70 36Z"/><path d="M213 371c-32-15-22-52 1-85s18-68 28-88 56-11 43 23-61 86-44 125-10 35-28 25Z"/></g><g fill="#f5dfbd"><circle cx="241" cy="220" r="7"/><circle cx="209" cy="318" r="7"/><circle cx="277" cy="388" r="7"/><circle cx="154" cy="375" r="4"/><circle cx="320" cy="166" r="4"/></g><g stroke="#fff" stroke-opacity=".6" stroke-width="1"><path d="M241 220h142M209 318H77M277 388h155"/></g><g fill="#f5dfbd" font-family="monospace" font-size="11"><text x="387" y="216">SENSOR 01</text><text x="28" y="311">02</text><text x="438" y="393">03</text></g></svg><div class="art-caption"><span>Movement, made measurable.</span><span>Concept illustration</span></div></div>
        </article>
        <div class="project-grid">{projects.slice(1).map((project, i) => <article class="project"><div class="project-top"><span class="project-number">0{i+2}</span><span class="eyebrow">{project.category}</span></div><h3>{project.name}</h3><p>{project.description}</p><p class="detail">{project.detail}</p><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul><div class="project-footer"><span>{project.stage}</span>{project.href && <a href={project.href} target="_blank" rel="noopener noreferrer">Explore project ↗</a>}</div></article>)}</div>
      </section>
      <section id="about" class="about" aria-labelledby="about-title"><div class="about-heading"><span class="eyebrow">The person behind the projects</span><h2 id="about-title">Curiosity is<br/>the <em>constant.</em></h2><div class="about-mark" aria-hidden="true">a<span>r.</span></div></div><div class="about-copy"><p class="lead">{profile.title}, with an interest in how things work — and how they could work better.</p><p>{profile.about}</p><p>{profile.community}</p><p>{profile.personal}</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">Follow the work on GitHub ↗</a></div></section>
      <section class="experience" aria-labelledby="experience-title"><div class="section-line"><h2 id="experience-title">Along the way</h2><span>Work, research & community</span></div><div class="history">{history.map(item => <article><span class="history-date">{item.date}</span><div><span class="eyebrow">{item.kind}</span><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
      <section id="contact" class="contact"><span class="eyebrow">The next good thing starts with a conversation.</span><h2>Have something<br/>in <em>mind?</em></h2><a class="email" href={`mailto:${profile.email}`}>{profile.email} <span>↗</span></a></section>
    </main>
    <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Thoughtfully made. Always evolving.</span><div><a href={profile.github}>GitHub ↗</a><a href={profile.linkedin}>LinkedIn ↗</a><a href="#">Back to top ↑</a></div></footer>
  </div>
</Base>
<style is:global>
:root{--paper:#f3efe5;--ink:#25271f;--rust:#a63f29;--line:#ccc8bb}body{background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.55}::selection{background:var(--rust);color:var(--paper)}a{text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:5px}.page{max-width:1680px;margin:auto;padding:0 5.4%}.masthead{display:flex;align-items:center;justify-content:space-between;padding:30px 0 27px;border-bottom:1px solid var(--ink)}.wordmark{font-size:25px;font-weight:700;letter-spacing:-1px;line-height:1.15}.wordmark span{display:block;font-size:10px;font-weight:400;letter-spacing:.035em;margin-top:9px}.masthead nav{display:flex;gap:34px;font-size:13px}.issue{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em;text-transform:uppercase;margin:23px 0 38px}.hero{padding-bottom:75px}.hero h1{position:relative;font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:clamp(86px,12.3vw,194px);line-height:.88;letter-spacing:-.075em;margin:0 0 47px;max-width:1100px}em{font-weight:400;color:var(--rust)}.asterisk{position:absolute;left:74%;top:12%;font-family:Arial,sans-serif;font-size:140px;line-height:1;color:var(--rust);letter-spacing:0}.hero-bottom{display:grid;grid-template-columns:1fr 1.65fr .35fr;gap:50px;align-items:end}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.13em;line-height:1.7}.hero-bottom p{margin:0}.hero-bottom>p:nth-child(2){font-size:19px;max-width:570px;line-height:1.5}.circle-link{border:1px solid var(--ink);width:61px;height:61px;border-radius:50%;display:grid;place-items:center;justify-self:end;font-size:28px;transition:background .2s,color .2s}.circle-link:hover{background:var(--ink);color:var(--paper);text-decoration:none}.section-line{border-top:1px solid var(--ink);display:flex;justify-content:space-between;align-items:center;padding:17px 0 29px;gap:20px}.section-line h2{font-size:13px;font-weight:500;margin:0}.section-line>span{font-size:10px;letter-spacing:.06em;text-transform:uppercase}.feature{display:grid;grid-template-columns:1fr 1.13fr;gap:6%;margin-bottom:65px}.feature-copy{padding:35px 0 15px}.feature h3{font-size:15px;font-weight:400;margin:26px 0}.feature h3>span{display:block;font-family:Georgia,serif;font-size:clamp(35px,4.4vw,64px);letter-spacing:-.05em;line-height:1.05;margin-top:12px}.feature-copy>p{font-size:18px;max-width:470px}.detail{font-size:14px!important;line-height:1.7;color:#5e6155}.tags{display:flex;flex-wrap:wrap;list-style:none;padding:0;gap:6px;margin:23px 0}.tags li{font-size:10px;border:1px solid #b5b7a8;padding:4px 9px;border-radius:20px}.status{font-size:11px;color:#666958}.status:before{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--rust);margin-right:8px}.pressure-art{background:var(--rust);color:var(--paper);display:flex;flex-direction:column;overflow:hidden;min-width:0}.art-top,.art-caption{display:flex;justify-content:space-between;gap:15px;padding:22px 24px;font-size:9px;letter-spacing:.1em}.pressure-art svg{display:block;width:100%;height:auto;max-height:490px;flex:1}.art-caption{letter-spacing:0;font-size:11px}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);column-gap:6%;}.project{border-top:1px solid var(--line);padding:27px 0 34px;display:flex;flex-direction:column}.project-top{display:flex;align-items:center;gap:18px;margin-bottom:27px}.project-number{font-family:Georgia,serif;font-size:24px;color:var(--rust);line-height:1}.project h3{font-family:Georgia,serif;font-size:36px;font-weight:400;letter-spacing:-.035em;margin-bottom:15px}.project p{max-width:520px;font-size:16px;margin-bottom:10px}.project .tags{margin:13px 0 26px}.project-footer{margin-top:auto;font-size:11px;display:flex;gap:20px;justify-content:space-between}.project-footer>a{text-decoration:underline;text-underline-offset:4px}.about{margin:75px -6.05% 75px;padding:65px 5.4%;background:#dfe0d3;display:grid;grid-template-columns:1fr 1.13fr;gap:6%}.about h2{font-family:Georgia,serif;font-size:clamp(48px,5.3vw,76px);line-height:1.05;font-weight:400;letter-spacing:-.05em;margin:27px 0}.about-mark{font-family:Georgia,serif;font-style:italic;font-size:110px;letter-spacing:-15px;line-height:.8;color:#7f856b;margin-top:45px}.about-mark span{color:var(--rust)}.about-copy{padding-top:42px;max-width:550px}.about-copy .lead{font-size:24px;line-height:1.4}.about-copy>p{font-size:16px;color:#404638;margin-bottom:22px}.text-link{display:inline-block;margin-top:12px;font-size:12px;border-bottom:1px solid var(--ink);padding-bottom:5px}.history{max-width:900px;margin-left:auto}.history article{display:grid;grid-template-columns:155px 1fr;gap:30px;padding:30px 0;border-bottom:1px solid var(--line)}.history-date{font-size:12px;padding-top:4px}.history h3{font-size:21px;letter-spacing:-.025em;font-weight:400;margin:7px 0 10px}.history p{color:#5e6155;font-size:14px;margin:0;max-width:620px}.contact{padding:100px 0 85px}.contact h2{font-family:Georgia,serif;font-size:clamp(65px,9vw,135px);font-weight:400;line-height:.98;letter-spacing:-.055em;margin:25px 0 38px}.email{font-size:clamp(16px,2.4vw,30px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:18px;max-width:690px}.email span{font-size:38px}footer{border-top:1px solid var(--ink);padding:27px 0 32px;display:flex;justify-content:space-between;gap:25px;font-size:10px}footer>div{display:flex;gap:23px}@media(min-width:1680px){.hero h1{font-size:194px}}@media(max-width:900px){.asterisk{font-size:100px;left:77%;top:25%}.hero-bottom{gap:25px;grid-template-columns:.8fr 1.6fr .3fr}.hero-bottom>p:nth-child(2){font-size:16px}.feature{gap:5%;grid-template-columns:1fr 1fr}.feature-copy{padding-top:10px}.feature-copy>p{font-size:16px}.art-top,.art-caption{padding:16px;flex-wrap:wrap}.about-copy .lead{font-size:20px}.history{margin-left:0}footer>span:nth-child(2){display:none}}@media(max-width:600px){.page{padding:0 6%}.masthead{align-items:start;padding:22px 0}.wordmark{font-size:20px}.wordmark span{font-size:8px;max-width:160px}.masthead nav{gap:14px;font-size:11px;flex-wrap:wrap;justify-content:end;max-width:160px}.masthead nav a:last-child{display:none}.issue{font-size:8px;gap:20px;margin-bottom:45px}.issue>span:first-child{max-width:180px}.issue>span:last-child{text-align:right}.hero h1{font-size:clamp(75px,15.6vw,95px);margin-bottom:33px}.asterisk{font-size:61px;top:43%;left:78%}.hero-bottom{grid-template-columns:1fr 52px;gap:23px}.hero-bottom>.eyebrow{grid-column:1/-1;font-size:9px}.hero-bottom>p:nth-child(2){font-size:16px}.circle-link{width:48px;height:48px;font-size:24px}.hero{padding-bottom:48px}.section-line{padding-bottom:22px;align-items:start}.section-line>span{font-size:8px;max-width:130px;text-align:right}.feature{grid-template-columns:1fr;gap:25px;margin-bottom:35px}.feature h3>span{font-size:49px}.feature-copy{padding:8px 0}.feature h3{margin-top:20px}.pressure-art svg{max-height:370px}.project-grid{grid-template-columns:1fr}.project h3{font-size:33px}.project-top{margin-bottom:18px}.about{grid-template-columns:1fr;padding:40px 6%;margin:35px -6.82% 45px;gap:15px}.about h2{font-size:56px;margin:20px 0}.about-mark{display:none}.about-copy{padding-top:0}.history article{grid-template-columns:1fr;gap:12px;padding:24px 0}.history h3{font-size:20px}.history-date{color:var(--rust)}.contact{padding:65px 0 50px}.contact h2{font-size:65px}.contact>.eyebrow{font-size:8px}.email{font-size:18px}.email span{font-size:28px}footer{flex-direction:column;gap:15px;font-size:10px}footer>div{justify-content:space-between}}
</style>
